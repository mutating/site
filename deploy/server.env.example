# Created once by setup-server.yml; stored at /etc/throng/throng.env.
THRONG_DATABASE_URL=sqlite+aiosqlite:////var/lib/throng/throng.db
THRONG_STORAGE_PATH=/var/lib/throng/artifacts
THRONG_ALLOW_REGISTRATION=true
THRONG_BROWSER_ORIGINS=["https://platform.mutating.tech"]
THRONG_BROWSER_SECURE_COOKIE=true
DASHBOARD_API_URL=https://api.mutating.tech/v1
