# Created once by setup-server.yml; stored at /etc/throng/throng.env.
THRONG_DATABASE_URL=sqlite+aiosqlite:////var/lib/throng/throng.db
THRONG_STORAGE_PATH=/var/lib/throng/artifacts
THRONG_ALLOW_REGISTRATION=true
THRONG_BROWSER_ORIGINS=["https://platform.mutating.tech"]
THRONG_BROWSER_SECURE_COOKIE=true
DASHBOARD_API_URL=https://api.mutating.tech/v1

# Enable Power Cell with infra/playbooks/setup-powercell.yml after deploying.
# The administrator command preserves existing settings and provisions these
# values with persistent CA/recovery material; never put private values in Git.
# THRONG_POWERCELL_ACME_URL=https://api.mutating.tech/acme/powercell
# THRONG_POWERCELL_CA_CERTIFICATE=/etc/throng/powercell/issuer/ca.pem
# THRONG_POWERCELL_CA_KEY=/etc/throng/powercell/issuer/ca-key.pem
# THRONG_POWERCELL_SECRET=<persistent random secret, generated once>
# THRONG_POWERCELL_RELAY_URL=https://api.mutating.tech:8444
# THRONG_POWERCELL_RELAY_CERTIFICATE=/etc/throng/powercell/tls/fullchain.pem
# THRONG_POWERCELL_RELAY_KEY=/etc/throng/powercell/tls/privkey.pem
# THRONG_POWERCELL_RELAY_HOST=0.0.0.0
