[Unit]
Description=Throng API, controller and platform dashboard
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=throng
Group=throng
WorkingDirectory=/opt/mutating/current
EnvironmentFile=/etc/throng/throng.env
ExecStart=/opt/mutating/current/platform/api/.venv/bin/python /opt/mutating/current/deploy/run.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/throng

[Install]
WantedBy=multi-user.target
