# Dedicated virtual hosts; installed alongside mutating.tech's existing config.
server {
    listen 80;
    listen [::]:80;
    server_name api.mutating.tech platform.mutating.tech;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location ^~ /acme/powercell/ {
        access_log off;
        error_log /dev/null crit;
        return 308 https://$host$request_uri;
    }
    location / { return 308 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.mutating.tech;
    ssl_certificate {{ certificate_path }}/fullchain.pem;
    ssl_certificate_key {{ certificate_path }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 100m;

    # The URL contains a per-enrollment capability, including on 4xx/5xx.
    location ^~ /acme/powercell/ {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        # Agent long polling can last 25 seconds; uploads may take longer.
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name platform.mutating.tech;
    ssl_certificate {{ certificate_path }}/fullchain.pem;
    ssl_certificate_key {{ certificate_path }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 3m;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
