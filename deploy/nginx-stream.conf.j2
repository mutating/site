# Managed by infra/playbooks/setup-proxy.yml; dedicated TCP proxy.
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 4096;
}

stream {
    log_format proxy '$remote_addr [$time_local] $protocol $status '
                     'sent=$bytes_sent received=$bytes_received '
                     'duration=$session_time upstream=$upstream_addr '
                     'connect=$upstream_connect_time';
    access_log /var/log/nginx/stream-access.log proxy;

    proxy_connect_timeout {{ proxy_connect_timeout }};
    proxy_timeout {{ proxy_idle_timeout }};
    proxy_socket_keepalive on;

    # Keep TLS, SNI, HTTP Host and ACME HTTP-01 handling on the origin.
    # A literal origin IP prevents a loop when public DNS includes this proxy.
    server {
        listen 0.0.0.0:80;
        proxy_pass {{ proxy_origin_ipv4 }}:80;
    }

    server {
        listen 0.0.0.0:443;
        proxy_pass {{ proxy_origin_ipv4 }}:443;
    }

    # api.mutating.tech also advertises this mTLS/HTTP2 relay port.
    # Pass client certificates to the origin and preserve long-lived sessions.
    server {
        listen 0.0.0.0:8444;
        proxy_timeout {{ proxy_relay_idle_timeout }};
        proxy_pass {{ proxy_origin_ipv4 }}:8444;
    }
}
