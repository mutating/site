THRONG_DATABASE_URL=sqlite+aiosqlite:///./data/throng.db
THRONG_STORAGE_PATH=./data/artifacts
THRONG_ALLOW_REGISTRATION=true
THRONG_CONTROLLER_INTERVAL=1
THRONG_AGENT_LEASE_SECONDS=60
THRONG_ISOLATE_TTL_SECONDS=3600
THRONG_MAX_ARTIFACT_BYTES=104857600

# Shared API + web launch (the Vite development server uses platform/web/.env).
DASHBOARD_PUBLIC_ORIGIN=http://127.0.0.1:8001
DASHBOARD_SECURE_COOKIE=false
# A persistent key is generated automatically during server provisioning.
# DASHBOARD_SESSION_KEY=

# Optional Power Cell issuer. Set all four together; no development CA is generated.
# THRONG_POWERCELL_ACME_URL=https://example.org/acme/powercell
# THRONG_POWERCELL_CA_CERTIFICATE=/run/secrets/powercell-ca.pem
# THRONG_POWERCELL_CA_KEY=/run/secrets/powercell-ca-key.pem
# THRONG_POWERCELL_SECRET=<persistent random secret of at least 32 characters>

# Native macOS relay: same process as the API, separate TLS listener with mTLS.
# Expose this port directly (no TLS termination at the HTTP reverse proxy).
# THRONG_POWERCELL_RELAY_URL=https://relay.example.org:8444
# THRONG_POWERCELL_RELAY_CERTIFICATE=/run/secrets/relay-fullchain.pem
# THRONG_POWERCELL_RELAY_KEY=/run/secrets/relay-key.pem
# THRONG_POWERCELL_RELAY_HOST=0.0.0.0
