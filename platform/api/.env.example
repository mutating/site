THRONG_DATABASE_URL=sqlite+aiosqlite:///./data/throng.db
THRONG_STORAGE_PATH=./data/artifacts
THRONG_ALLOW_REGISTRATION=true
THRONG_CONTROLLER_INTERVAL=1
THRONG_AGENT_LEASE_SECONDS=60
THRONG_ISOLATE_TTL_SECONDS=3600
THRONG_MAX_ARTIFACT_BYTES=104857600

# Shared API + web launch (the Vite development server uses platform/web/.env).
DASHBOARD_API_URL=http://127.0.0.1:8000/v1
THRONG_PLATFORM_ORIGIN=http://127.0.0.1:8001
THRONG_BROWSER_ORIGINS=["http://127.0.0.1:8001","http://127.0.0.1:5173"]
THRONG_BROWSER_SECURE_COOKIE=false

# Power Cell registration. The secret encrypts only the recoverable credential
# for an exact enrollment-finish retry; it is not a trust anchor.
# THRONG_ENROLLMENT_SECRET=<persistent random secret of at least 32 characters>

# Optional GitHub App integration. Set all seven credentials together.
# OAuth/setup callbacks, repository discovery and CI routing; see docs/github.md.
# THRONG_GITHUB_APP_ID=12345
# THRONG_GITHUB_APP_SLUG=your-app-slug
# THRONG_GITHUB_CLIENT_ID=your-client-id
# THRONG_GITHUB_CLIENT_SECRET=<client secret>
# THRONG_GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# THRONG_GITHUB_WEBHOOK_SECRET=<persistent random secret of at least 32 characters>
# THRONG_GITHUB_TOKEN_KEY=<persistent Fernet.generate_key() value>
# THRONG_GITHUB_PUBLIC_API_URL=https://api.mutating.tech
# THRONG_GITHUB_DASHBOARD_URL=https://platform.mutating.tech
