{
  "name": "mutating",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/ui",
    "platform/web"
  ],
  "scripts": {
    "postinstall": "npm ci --prefix tools/http-lint --ignore-scripts",
    "lint": "npm run lint --prefix tools/http-lint --",
    "test:lint": "node --test tests/lint/*.test.mjs",
    "build:ui": "npm run build --workspace @mutating/ui",
    "dev:ui": "npm run dev --workspace @mutating/ui",
    "test:ui": "npm run test --workspace @mutating/ui",
    "build:site": "npm run build:ui && hugo --source site --cleanDestinationDir --minify --environment production",
    "test:site:header": "tsc --noEmit -p tests/site/header/tsconfig.json && npm run build:ui && playwright test -c tests/site/header/playwright.config.ts",
    "build:web": "npm run build --workspace platform/web",
    "test:web:unit": "npm run test:unit --workspace platform/web",
    "test:web:e2e": "npm run test:e2e --workspace platform/web",
    "test:web:header-shared": "npm run test:header-shared --workspace platform/web",
    "test:web:deploy": "npm run test:deploy --workspace platform/web",
    "test:web:visual": "npm run test:visual --workspace platform/web"
  },
  "type": "module",
  "dependencies": {
    "reboop": "0.1.34"
  }
}
